    @Test
    void shouldMergeByNameAndCategoryWhenOpisDiffers() throws Exception {
        MockMultipartFile first = workbookWithSingleRow("LOZYSKO 608", "STARY OPIS", 1, "szt.", "MONTAZ", "2026-01-02", "2026-01-03");
        service.importFile(first);

        MockMultipartFile second = workbookWithSingleRow("LOZYSKO 608", "NOWY OPIS", 7, "szt.", "MONTAZ", "2026-02-02", "2026-02-03");
        PartExcelImportResultDTO merged = service.importFile(second, PartExcelImportService.ImportMode.MERGE);

        assertThat(merged.getCreatedCount()).isEqualTo(0);
        assertThat(merged.getUpdatedCount()).isEqualTo(1);

        List<Part> parts = partRepository.findAll();
        assertThat(parts).hasSize(1);
        assertThat(parts.get(0).getOpis()).isEqualTo("NOWY OPIS");
        assertThat(parts.get(0).getIlosc()).isEqualTo(7);
        assertThat(parts.get(0).getDataZakupu()).isEqualTo(LocalDate.of(2026, 2, 2));
        assertThat(parts.get(0).getDataRealizacji()).isEqualTo(LocalDate.of(2026, 2, 3));
    }

    @Test
    void shouldFailWhenRequiredHeaderIsMissing() throws IOException {
        try (XSSFWorkbook workbook = new XSSFWorkbook(); ByteArrayOutputStream bos = new ByteArrayOutputStream()) {
            var sheet = workbook.createSheet("Import");
            Row header = sheet.createRow(0);
            header.createCell(0).setCellValue("NAZWA");
            header.createCell(1).setCellValue("OPIS");
            workbook.write(bos);

            MockMultipartFile broken = new MockMultipartFile(
                    "file",
                    "broken.xlsx",
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                    bos.toByteArray()
            );
            assertThat(row.getCell(1).getStringCellValue()).isEqualTo("ZAWOR");
            assertThat(row.getCell(2).getStringCellValue()).isEqualTo("ZWROTNO-DLAWIACY FI6");
            assertThat(row.getCell(3).getStringCellValue()).isEqualTo("12");
            assertThat(row.getCell(4).getStringCellValue()).isEqualTo("szt.");
            assertThat(row.getCell(9).getStringCellValue()).isEqualTo("WARSZTAT");
        }
    }

