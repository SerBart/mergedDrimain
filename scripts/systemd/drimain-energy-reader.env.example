# Copy this file to /etc/drimain-energy-reader.env and set real values.

# Railway ingest endpoint
DRIMAIN_API_URL=https://mergeddrimain-production.up.railway.app/api/energia/readings

# Must match ENERGY_INGEST_KEY from Railway service
ENERGY_INGEST_KEY=PUT_REAL_SECRET_HERE

# Existing machine id in backend database
MASZYNA_ID=1

# Modbus transport: rtu (RS485 USB) or tcp
MODBUS_MODE=rtu

# Read/send interval in seconds
READ_INTERVAL=5

# Meter connection (set real values when hardware is connected)
METER_TYPE=LUMEL_NMID30_1
METER_IP=192.168.1.50
METER_PORT=502
METER_SLAVE_ID=1

# RS485 USB settings for MODBUS_MODE=rtu
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=9600
PARITY=N
STOP_BITS=1
BYTE_SIZE=8

# Register map indexes in the read block (2x16-bit float32 pairs)
# Set these values according to Lumel NMID30-1 Modbus register table.
REG_VOLTAGE_IDX=0
REG_CURRENT_IDX=6
REG_POWER_IDX=12
REG_ENERGY_TOTAL_IDX=72

# Set to true only for demo without hardware
DEMO_MODE=false


